<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YouTubeDownloader.Views.WarningView">


    <StackPanel
        Spacing="20"
        HorizontalAlignment="Center">


        <TextBlock
            Text="{DynamicResource Message.WarningBoth}"
			Margin="0,10"
            Foreground="{DynamicResource HeadingTextBrush}"
            FontSize="16"
			TextAlignment="Center"
            HorizontalAlignment="Center"/>



        <Button
            Width="100"
            Height="30"
			Margin="0,0"
            Content="{DynamicResource Button.Ok}"
            Classes="fluent"
			HorizontalAlignment="Center"
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center"
            Click="Ok_Click"/>


    </StackPanel>


</UserControl>