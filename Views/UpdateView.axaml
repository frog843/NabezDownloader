<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YouTubeDownloader.Views.UpdateView">

    <StackPanel
        Spacing="18"
        HorizontalAlignment="Center">

        <TextBlock
            Text="{DynamicResource Update.Available}"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{DynamicResource HeadingTextBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

        <TextBlock
            x:Name="VersionInfo"
            Text=""
            FontSize="14"
            Foreground="{DynamicResource SubtitleTextBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

        <Border
            Background="{DynamicResource InnerRowBackgroundBrush}"
            CornerRadius="10"
            Padding="14"
            MaxWidth="340">
            <ScrollViewer
                MaxHeight="160">
                <TextBlock
                    x:Name="Notes"
                    Text=""
                    FontSize="13"
                    Foreground="{DynamicResource LabelTextBrush}"
                    TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <ProgressBar
            x:Name="Progress"
            Height="10"
            Minimum="0"
            Maximum="100"
            Value="0"
            IsVisible="False"
            Foreground="{DynamicResource AccentBrush}"
            Background="{DynamicResource InnerRowBackgroundBrush}"/>

        <TextBlock
            x:Name="Status"
            Text=""
            FontSize="13"
            Foreground="{DynamicResource SubtitleTextBrush}"
            HorizontalAlignment="Center"
            IsVisible="False"/>

        <StackPanel
            x:Name="Buttons"
            Orientation="Horizontal"
            Spacing="10"
            HorizontalAlignment="Center">

            <Button
                x:Name="DownloadButton"
                Width="130"
                Height="34"
                Content="{DynamicResource Update.Download}"
                Classes="fluent"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="Download_Click"/>

            <Button
                x:Name="LaterButton"
                Width="110"
                Height="34"
                Content="{DynamicResource Update.Later}"
                Classes="fluent"
                Background="{DynamicResource CardBackgroundBrush}"
                Foreground="{DynamicResource HeadingTextBrush}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="Later_Click"/>

        </StackPanel>

    </StackPanel>

</UserControl>
